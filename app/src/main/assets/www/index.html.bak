<button id="__crono">00:00:00</button>

<script>
(function () {
  var crono = document.getElementById('__crono');
  var corriendo = false;
  var inicio = 0;
  var acumulado = 0;

  function formato(ms) {
    var s = Math.floor(ms / 1000);
    var h = Math.floor(s / 3600);
    var m = Math.floor((s % 3600) / 60);
    var seg = s % 60;
    function p(n) { return n < 10 ? '0' + n : '' + n; }
    return p(h) + ':' + p(m) + ':' + p(seg);
  }

  function tick() {
    var t = acumulado;
    if (corriendo) t += Date.now() - inicio;
    if (crono) crono.textContent = formato(t);
  }
  setInterval(tick, 500);
  tick();

  crono.addEventListener('click', function () {
    if (corriendo) {
      // segundo clic: reiniciar a cero
      corriendo = false;
      acumulado = 0;
      inicio = 0;
    } else {
      // primer clic: iniciar
      inicio = Date.now();
      corriendo = true;
    }
    tick();
  });

  function ocultarEnPokemon() {
    var hayPokemon = document.querySelector('.pokemon-card');
    var hayDetalle = document.querySelector('.details');
    var ocultar = !!(hayPokemon || hayDetalle);
    if (crono) crono.style.display = ocultar ? 'none' : '';
  }
  setInterval(ocultarEnPokemon, 500);
})();
</script>
</body>
</html>
