      ::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.15); border-radius: 8px; }
    
      /* FONDO: quitar barrido y partículas */
      .background,
      .background::before,
      .background::after,
      .background__particle,
      .background__glow {
        animation: none !important;
        transition: none !important;
      }
      .background::before,
      .background::after {
        display: none !important;
      }
      .background__particle {
        display: none !important;
      }

      /* CARD: quitar crecimiento y sombra al pulsar/hover/active */
      .card,
      .card--region,
      .card:hover,
      .card--region:hover,
      .card:active,
      .card--region:active,
      .card.is-active,
      .card--region.is-active {
        animation: none !important;
        transition: none !important;
        transform: none !important;
        box-shadow: none !important;
      }
      .card::before,
      .card::after,
      .card--region::before,
      .card--region::after {
        animation: none !important;
        transition: none !important;
