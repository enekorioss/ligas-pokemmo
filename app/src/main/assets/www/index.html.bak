      }

      /* POKEMON CARD: quitar también el hover/active */
      .pokemon-card,
      .pokemon-card:hover,
      .pokemon-card.is-active {
        animation: none !important;
        transition: none !important;
        transform: none !important;
      }

      /* Quitar el anillo del card de región al activarse */
      .card,
      .card--region,
      .card.is-active,
      .card--region.is-active,
      .card:hover,
      .card--region:hover,
      .card:focus,
      .card--region:focus,
      .card:active,
