        opacity: 1 !important;
        transform: none !important;
      }

      /* Resaltar el Pokémon activo y atenuar los demás */
      .pokemon-card {
        position: relative;
        transition: none !important;
      }
      .pokemon-card.is-active {
        outline: 3px solid #4ade80 !important;
