  <body>
    <div id="root"></div>
    <script>
    (function () {
      function focusables() {
        document.querySelectorAll('.card, [role="button"], .credits__btn--next').forEach((el) => {
          if (!el.hasAttribute('tabindex')) el.setAttribute('tabindex', '0');
        });
      }
      function lazyImages() {
        document.querySelectorAll('img').forEach((img) => {
          if (!img.hasAttribute('loading')) img.setAttribute('loading', 'lazy');
          if (!img.hasAttribute('decoding')) img.setAttribute('decoding', 'async');
        });
      }
      const OCULTAR_TEXTO = ['Cerrar Sesión', 'Cerrar sesion'];
      function ocultarSesion() {
        document.querySelectorAll('button, a, span, div, p').forEach((el) => {
          if (el.children.length > 0) return;
          const t = el.textContent.trim();
          for (const p of OCULTAR_TEXTO) {
            if (t === p) {
              el.style.display = 'none';
              const par = el.parentElement;
              if (par && (/@/.test(par.textContent || '') || /Usuario:/i.test(par.textContent || ''))) par.style.display = 'none';
            }
          }
        });
        document.querySelectorAll('span, div, p, small').forEach((el) => {
          if (el.children.length > 0) return;
          const t = el.textContent.trim();
          if (/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(t)) {
            const par = el.parentElement;
            if (par) par.style.display = 'none'; else el.style.display = 'none';
          }
        });
      }
      function aplicar() { focusables(); lazyImages(); ocultarSesion(); }
      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', aplicar);
      else aplicar();
      [300, 800, 1500, 3000, 6000].forEach((ms) => setTimeout(aplicar, ms));
      let pendiente = false;
      new MutationObserver(() => {
        if (pendiente) return;
        pendiente = true;
        setTimeout(() => { pendiente = false; aplicar(); }, 300);
      }).observe(document.body, { childList: true, subtree: true });

      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('./sw.js').catch(() => {});
        });
      }
    })();
    </script>
  
    <script>
    (function () {
      let lastLeader = null;
      let lastPokemons = null;

      function scrollToPokemons() {
        const sec = document.querySelector('.guide__pokemons');
        if (!sec || sec.children.length === 0) return;
        // evitar repetir scroll si no cambia el contenido
        const firma = sec.textContent.trim().slice(0, 80);
        if (firma === lastPokemons) return;
        lastPokemons = firma;
        
      }

      let pendiente = false;
      new MutationObserver(() => {
        if (pendiente) return;
        pendiente = true;
        setTimeout(() => {
          pendiente = false;
          scrollToPokemons();
        }, 200);
      }).observe(document.body, { childList: true, subtree: true });
    })();
    </script>

<script>
(function () {
  // Modo TV: hacer focusables los clicables no nativos
  var SELECTORES = [
    '.trick__box',
    '.trick__box--expandable',
    '.trick__team-link',
    '.card',
    '.card--leader',
    '.card--region',
    '.pokemon-card',
    '.details__tricks > *',
    '[onclick]'
  ];

  function focusables() {
    SELECTORES.forEach(function (sel) {
      document.querySelectorAll(sel).forEach(function (el) {
        if (el.tagName === 'BUTTON' || el.tagName === 'A') return;
        if (!el.hasAttribute('tabindex')) el.setAttribute('tabindex', '0');
        if (!el.hasAttribute('role')) el.setAttribute('role', 'button');
      });
    });
  }

  // Enter/Espacio activan el click en el elemento enfocado
  document.addEventListener('keydown', function (e) {
    if (e.key !== 'Enter' && e.key !== ' ') return;
    var el = document.activeElement;
    if (!el) return;
    if (el.tagName === 'BUTTON' || el.tagName === 'A' || el.tagName === 'INPUT') return;
    if (el.hasAttribute('tabindex')) {
      e.preventDefault();
      el.click();
    }
  });

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', focusables);
  else focusables();
  [300, 800, 1500, 3000, 6000].forEach(function (ms) { setTimeout(focusables, ms); });
  new MutationObserver(focusables).observe(document.body, { childList: true, subtree: true });
})();
</script>









































<script>
(function () {
  function crearBoton() {
    if (document.getElementById('__reload_btn')) return;
    var b = document.createElement('button');
    b.id = '__reload_btn';
    b.textContent = '↻';
    b.title = 'Recargar sin caché';
    b.style.cssText = 'position:fixed;top:8px;right:8px;z-index:999999;width:36px;height:36px;border-radius:50%;border:1px solid rgba(74,222,128,0.4);background:rgba(20,20,20,0.8);color:#4ade80;font-size:18px;line-height:1;cursor:pointer;';
    b.onclick = function () {
      b.textContent = '…';
      try {
        if ('serviceWorker' in navigator) {
          navigator.serviceWorker.getRegistrations().then(function (regs) {
            regs.forEach(function (r) { r.unregister(); });
          });
        }
        if ('caches' in window) {
          caches.keys().then(function (keys) {
            keys.forEach(function (k) { caches.delete(k); });
          });
        }
      } catch (e) {}
      setTimeout(function () { location.reload(true); }, 400);
    };
    document.body.appendChild(b);
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', crearBoton);
  else crearBoton();
  setInterval(crearBoton, 2000);
})();
</script>













<script>
(function () {
  var KEY_VISITADOS = 'farmligas_visitados';
  var KEY_LIDER = 'farmligas_ultimo_lider';
  var ultimoVisto = null;

  function getVisitados() {
    try { return JSON.parse(localStorage.getItem(KEY_VISITADOS) || '[]'); } catch (e) { return []; }
  }
  function setVisitados(a) { try { localStorage.setItem(KEY_VISITADOS, JSON.stringify(a)); } catch (e) {} }

  

  


  

    var total = document.querySelectorAll('.card--leader').length;
    var visitados = getVisitados().length;
    var pct = total ? Math.min(100, Math.round((visitados / total) * 100)) : 0;
    var f = document.getElementById('__prog_fill');
    if (f) f.style.width = pct + '%';
  }

  function liderActivoEl() {
    return document.querySelector('.card--leader.is-active');
  }
  function nombreDe(el) {
    if (!el) return '';
    var ov = el.querySelector('.card__overlay');
    return ov ? (ov.textContent || '').trim() : '';
  }

  function registrarVisitado() {
    var l = liderActivoEl();
    if (!l) { ultimoVisto = null; return; }
    var n = nombreDe(l);
    if (!n) return;
    if (n === ultimoVisto) return;
    ultimoVisto = n;
    var arr = getVisitados();
    if (arr.indexOf(n) === -1) { arr.push(n); setVisitados(arr); }
    progreso();
  }

  function guardarUltimo() {
    var l = liderActivoEl();
    if (l) localStorage.setItem(KEY_LIDER, nombreDe(l));
  }

  function infoLider() {
    var next = document.querySelector('.credits__btn--next');
    if (!next) return;
    var cont = document.getElementById('__lider_info');
    if (!cont) {
      cont = document.createElement('div');
      cont.id = '__lider_info';
      cont.style.cssText = 'margin:8px 12px;padding:8px 12px;border-radius:10px;border:1px solid rgba(74,222,128,0.3);background:rgba(74,222,128,0.06);color:#d1fae5;font-size:0.9rem;';
      next.parentElement.insertBefore(cont, next.nextSibling);
    }
    var act = liderActivoEl();
    if (!act) { cont.style.display = 'none'; return; }
    var nombre = nombreDe(act);
    var lista = document.querySelectorAll('.card--leader');
    var numero = 0;
    for (var i = 0; i < lista.length; i++) { if (lista[i] === act) { numero = i + 1; break; } }
    cont.style.display = 'block';
    cont.textContent = 'Líder ' + numero + ': ' + nombre;
  }

  function finRun() {
    var next = document.querySelector('.credits__btn--next');
    if (!next) return;
    var regiones = document.querySelectorAll('.card--region');
    var lideres = document.querySelectorAll('.card--leader');
    var regionAct = document.querySelector('.card--region.is-active');
    var liderAct = liderActivoEl();
    if (!regiones.length || !lideres.length || !regionAct || !liderAct) {
      next.style.display = '';
      return;
    }
    var ultimaRegion = regiones[regiones.length - 1];
    var ultimoLider = lideres[lideres.length - 1];
    if (regionAct === ultimaRegion && liderAct === ultimoLider) {
      next.style.display = 'none';
    } else {
      next.style.display = '';
    }
  }

  setInterval(function () {
    guardarUltimo();
    registrarVisitado();
    progreso();
    infoLider();
    finRun();
  }, 800);
})();
</script>

<script>
(function () {
  var yaPrefetch = {};
  function prefetchLideres() {
    var regionAct = document.querySelector('.card--region.is-active');
    if (!regionAct) return;
    // imágenes de líderes de la región actual
    document.querySelectorAll('.card--leader').forEach(function (l) {
      var img = l.querySelector('.card__leader-image');
      if (!img || !img.src) return;
      if (yaPrefetch[img.src]) return;
      yaPrefetch[img.src] = true;
      var link = document.createElement('link');
      link.rel = 'prefetch';
      link.as = 'image';
      link.href = img.src;
      document.head.appendChild(link);
    });
  }
  setInterval(prefetchLideres, 1500);
})();
</script>

<script>
(function () {
  var DUR = 200;
  var raf = null;
  var orig = Element.prototype.scrollIntoView;
  Element.prototype.scrollIntoView = function (opts) {
    var el = this;
    var rect = el.getBoundingClientRect();
    var targetY = window.scrollY + rect.top - 80;
    if (raf) cancelAnimationFrame(raf);
    var startY = window.scrollY;
    var dist = targetY - startY;
    if (Math.abs(dist) < 2) return;
    var start = performance.now();
    function step(now) {
      var t = Math.min((now - start) / DUR, 1);
      var ease = t < 0.5 ? 2 * t * t : -1 + (4 - 2 * t) * t;
      window.scrollTo(0, startY + dist * ease);
      if (t < 1) raf = requestAnimationFrame(step);
      else raf = null;
    }
    raf = requestAnimationFrame(step);
  };
})();
</script>












